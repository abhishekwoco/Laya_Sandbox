# Copy this file to `.env` in the project root (D:\Laya_Sandbox) and adjust as needed.
# Settings are read by src/laya_mcp/config.py (pydantic-settings), env prefix LAYA_MCP_.
# Anything left commented out uses the default baked into config.py.

# ---------------------------------------------------------------------------
# Hugging Face model cache — required so the server never tries to hit the
# network for weights it already has (this host only has outbound intranet
# access at deploy time, and offline mode makes cold starts predictable).
# Only the `english` checkpoint is cached today; run
# `venv\Scripts\python.exe scripts\prefetch_models.py` once, BEFORE setting
# HF_HUB_OFFLINE=1, to pull `multilingual` and `typed-decisions` too.
# ---------------------------------------------------------------------------
HF_HUB_OFFLINE=1
HF_HOME=C:\Users\Woco\.cache\huggingface

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
# LAYA_MCP_HOST=0.0.0.0
# LAYA_MCP_PORT=8765

# ---------------------------------------------------------------------------
# Storage — SQLite DB (schemas/datasets/reports/usage) and Huey job queue live
# under this directory. Back up laya_mcp.db and jobs.db before upgrades.
# ---------------------------------------------------------------------------
# LAYA_MCP_DATA_DIR=data

# ---------------------------------------------------------------------------
# Inference
# ---------------------------------------------------------------------------
# Device for torch. None (unset) lets laya pick — cpu on this host (no CUDA;
# the RX 6600M has no ROCm/CUDA support torch can use here).
# LAYA_MCP_DEVICE=

# torch intra-op threads. Keep at or below physical cores (8 on this host).
# scripts/bench.py sweeps 4/6/8 in Phase 0 — set this to whatever it recommends.
# Leave headroom for MySQL/Postgres/httpd/Ollama also running on this box.
# LAYA_MCP_THREADS=6

# Comma-separated checkpoints loaded at startup. Preloading avoids a 7-10s
# reload on every language switch. Keep just "english" unless most requests
# are non-English — each fp32 checkpoint is roughly 1.7 GB resident.
# LAYA_MCP_PRELOAD=english

# LRU cap on checkpoints kept resident at once (english/multilingual/typed-decisions).
# LAYA_MCP_MAX_LOADED=2

# Run one throwaway prediction after preload so the first real request isn't
# the one that pays for lazy CUDA/kernel warmup.
# LAYA_MCP_WARMUP=true

# int8 dynamic quantization of Linear layers (CPU only). Off by default —
# only turn on after scripts/bench.py confirms it doesn't move argmax or
# |confidence delta| beyond 0.02 on a fixed probe set. See docs/operations.md.
# LAYA_MCP_QUANTIZE=false

# ---------------------------------------------------------------------------
# Request limits — protect the single CPU inference worker from oversized
# synchronous calls. Oversized requests fail fast with a hint to use
# laya_classify_batch instead of silently blocking for tens of seconds.
# ---------------------------------------------------------------------------
# Max items x questions allowed in one synchronous (laya_classify/laya_decide) call.
# ~9-32 s per call on this host depending on input length (docs/perf.md).
# LAYA_MCP_SYNC_ROW_BUDGET=20

# Max characters of a single serialized state.
# LAYA_MCP_MAX_STATE_CHARS=20000

# Max questions per call.
# LAYA_MCP_MAX_QUESTIONS=20

# Max items per laya_classify_batch call (clients append in chunks for bigger jobs).
# LAYA_MCP_MAX_ITEMS_PER_CALL=500

# Per-request timeout for interactive (synchronous) calls, in seconds.
# LAYA_MCP_REQUEST_TIMEOUT_S=120.0

# Interactive calls allowed to queue behind the single inference lock before
# the server returns a retryable "busy" error.
# LAYA_MCP_MAX_WAITING_REQUESTS=4

# ---------------------------------------------------------------------------
# Decision policy defaults — used by laya_decide/laya_evaluate/laya_promote_schema
# when a schema doesn't override them.
# ---------------------------------------------------------------------------
# Confidence threshold above which an answer counts as "decided" (else needs_review).
# LAYA_MCP_DEFAULT_THRESHOLD=0.8

# Accuracy a schema's evaluation must reach (at its recommended threshold) to promote.
# LAYA_MCP_DEFAULT_TARGET_ACCURACY=0.9

# Minimum labeled examples an evaluation needs before laya_promote_schema will pass.
# LAYA_MCP_MIN_EVAL_EXAMPLES=50

# ---------------------------------------------------------------------------
# Jobs — SqliteHuey worker threads for laya_classify_batch / laya_evaluate.
# Keep at 1: they share the single inference lock with interactive calls, so
# more worker threads just add contention, not throughput.
# ---------------------------------------------------------------------------
# LAYA_MCP_JOB_WORKERS=1

# ---------------------------------------------------------------------------
# Identity / logging
# ---------------------------------------------------------------------------
# Team when a request has no X-Laya-Team header and no explicit `team` argument.
# LAYA_MCP_DEFAULT_TEAM=default

# Header clients set to identify their team (see docs/client-setup.md).
# LAYA_MCP_TEAM_HEADER=x-laya-team

# Never log raw state text unless you explicitly opt in (this can be customer
# data). Usage stats always store only counts and latencies, regardless.
# LAYA_MCP_LOG_CONTENT=false

# structlog level: DEBUG / INFO / WARNING / ERROR.
# LAYA_MCP_LOG_LEVEL=INFO
